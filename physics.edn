;; What this occupation's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a document-handling and policy-binder robot
;; performs policy printing, binder assembly and physical archival (ISCO 3321
;; insurance representatives). Its physical work: lifting assembled policy
;; binders to the archive shelf, and archiving them in a 2-hour-rated
;; fire-resistant record cabinet.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-3321"
 :cases
 [{:id :policy-binder-to-shelf
   :kind :manipulator
   :procedure "arm lifts an assembled policy binder from the assembly bench to the archive shelf"
   :params {:l1-m 0.45 :l2-m 0.40 :m1-kg 3.5 :m2-kg 2.5
            :from [0.55 0.05] :to [0.20 0.70] :duration-s 2.5 :steps 500}
   :sweep {:param :payload-kg :values [0.5 1.0 2.0 3.0 5.0]}
   :quantity :peak-tau1-nm
   :limit {:max 60.0 :basis "estimate: continuous shoulder torque of a light (~5 kg-payload) collaborative arm"}
   :boundary {:lo 0.1 :hi 20.0}}
  {:id :two-hour-record-cabinet-fire
   :kind :thermal
   :procedure "two hours of furnace exposure (wall face held at 1010 °C, no cool-down modeled) on the insulated wall of the policy record cabinet; interior face temperature"
   :params {:conductivity-w-mk 0.12 :density-kg-m3 900.0 :specific-heat-j-kgk 1000.0
            :t0-c 20.0 :t-hot-c 1010.0 :front-fixed? true :t-back-ambient-c 20.0 :h-back-w-m2k 5.0
            :threshold-c 177.0 :duration-s 7200.0}
   :sweep {:param :thickness-m :values [0.04 0.06 0.08 0.10 0.12]}
   :quantity :final-back-c
   :limit {:max 177.0 :basis "UL 72 Class 350 (paper records): interior must not exceed 350 °F (177 °C) during the fire-endurance test"}
   :boundary {:lo 0.02 :hi 0.14}}]}
